{
  "name": "atrium-agent-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:tokens && npm run format:check && npm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
